[diff]
    tool = vscode

[difftool "vscode"]
    cmd = code --wait --diff "$LOCAL" "$REMOTE"

# Authenticate GitHub over HTTPS with the GitHub CLI
[credential "https://github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential
